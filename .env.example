# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (AI filter pipeline) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── openFDA (FDA MAUDE scraper) ───────────────────────────────────────────────
# Optional but strongly recommended for production:
# Without key: 240 req/min, 1,000 req/day
# With key:    240 req/min, 120,000 req/day
# Register at: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── PDF generation (PDFShift) ─────────────────────────────────────────────────
PDFSHIFT_API_KEY=

# ── App URL (used for QR codes and absolute links) ───────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.onrender.com
