# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (AI filter pipeline) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional evaluation-only challenger. This is never a production fallback and
# customer-controlled evidence is not sent through it. Leave disabled unless a
# controlled benchmark run and provider review have been approved.
NEURIDION_CLOUDFLARE_SHADOW_ENABLED=false
# Allowed values: glm, nemotron
NEURIDION_CLOUDFLARE_SHADOW_MODEL=glm
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── openFDA (FDA MAUDE scraper) ───────────────────────────────────────────────
# Optional but strongly recommended for production:
# Without key: 240 req/min, 1,000 req/day
# With key:    240 req/min, 120,000 req/day
# Register at: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# ── Regulatory evidence capture ──────────────────────────────────────────────
# Enable only after migration 068 has been applied. Captures the exact adapter
# output used by the pipeline in the private regulatory-evidence bucket.
REGULATORY_EVIDENCE_CAPTURE=false
# Required allow-list when capture is enabled. Start with one EU source.
# FDA requires a separately approved personal-data retention policy.
REGULATORY_EVIDENCE_SOURCES=bfarm
# Separate approval gate for sources such as FDA that may contain third-party PII.
REGULATORY_EVIDENCE_ALLOW_SENSITIVE=false

# ── Scheduled mirror ingestion (dark by default) ─────────────────────────────
# Apply migrations 068 and 069 before enabling. FDA and EUDAMED are rejected.
SCHEDULED_INGESTION_SOURCES=
# Serving flags are foundations only until the source resolver is wired into the
# live pipeline after shadow validation. Defaults are live.
INGEST_MODE_SWISSMEDIC=live
INGEST_MODE_MHRA=live
INGEST_MODE_BFARM=live

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_ME

# ── Security alerting ────────────────────────────────────────────────────────
# Optional — email address for real-time security alerts (brute-force login,
# admin actions, account deletion, data export). Uses Resend to send.
SECURITY_ALERT_EMAIL=info@neuridion.eu

# ── PDF generation (PDFShift) ─────────────────────────────────────────────────
PDFSHIFT_API_KEY=

# ── Firecrawl (BfArM fallback scraper) ───────────────────────────────────────
# Optional — used when the BfArM HTML scraper returns empty results.
# Get a key at: https://firecrawl.dev
FIRECRAWL_API_KEY=

# ── App URL (used for QR codes and absolute links) ───────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.onrender.com

# ── Upstash QStash (async job queue) ─────────────────────────────────────────
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── AI pipeline limits ────────────────────────────────────────────────────────
# Max items sent to AI filter per run (default 300). Items beyond the cap
# receive filter_failed and require manual review.
MAX_FILTER_ITEMS_PER_RUN=500

# ── Audit log PII hashing (required — generate with: openssl rand -hex 32) ──
AUDIT_HMAC_KEY=

# ── Worker authentication (required — generate with: openssl rand -hex 32) ──
WORKER_API_SECRET=

# ── Development only — NEVER set in production ──────────────────────────────
# ENABLE_DEV_WORKER_BYPASS=true

# ── Email sender ─────────────────────────────────────────────────────────────
RESEND_FROM_ADDRESS=
