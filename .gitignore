# env files (can opt-in for committing if needed)
.env*
!.secrets.enc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings (may contain credentials)
.claude/settings.json
.claude/settings.local.json

# PRRC review agent outputs (may contain PII from test accounts)
docs/prrc-review/screenshots/
docs/prrc-review/PRRC-QA-Report-*.md
.superpowers/

# Playwright MCP temp artifacts
.playwright-mcp/

# Benchmark data (generated locally, not source-controlled until curated)
benchmark/fixtures/
benchmark/results/
